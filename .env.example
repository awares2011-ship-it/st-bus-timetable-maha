# Copy to .env and set your real site URL so SEO canonicals, Open Graph URLs,
# the sitemap, and prerendered pages point at the right domain.
#
# Used by the app at build time (import.meta.env.VITE_SITE_URL):
VITE_SITE_URL=https://your-domain.com

# Used by the Node build scripts (sitemap + prerender):
SITE_URL=https://your-domain.com

# --- Scraper (Render Cron) -------------------------------------------------
# Which source the data pipeline reads. 'demo' = local fixtures (safe default).
DATA_SOURCE=demo

# Contactable UA sent by the polite fetcher (used only for real sources).
SCRAPER_USER_AGENT=STBusTimetableBot/0.1 (+contact: you@example.com; respects robots.txt)

# Minimum delay (ms) between requests to the same host.
SCRAPER_MIN_DELAY_MS=3000

# Comma-separated official, permitted, machine-readable timetable document URLs.
# Leave empty until you have a permitted feed — the official booking portal must
# NOT be scraped for bulk timetables.
MSRTC_DOC_URLS=
