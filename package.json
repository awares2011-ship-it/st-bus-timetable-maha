{
  "name": "maharashtra-st-bus-timetable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Maharashtra ST Bus Timetable (MSRTC) — serverless, database-free, offline-first PWA. Static JSON data + client-side search. Independent public-transport information service, not affiliated with MSRTC.",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/sync-data.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-data.mjs",
    "build": "vite build",
    "postbuild": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync-data": "node scripts/sync-data.mjs",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:demo": "tsx scripts/scrape.ts --source=demo",
    "validate": "tsx scripts/validate.ts",
    "generate": "tsx scripts/generate.ts",
    "data:build": "tsx scripts/scrape.ts --source=demo && tsx scripts/validate.ts && tsx scripts/generate.ts && node scripts/sync-data.mjs",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/admob": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.3",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "node-html-parser": "^6.1.13",
    "pdfjs-dist": "^4.7.76",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.5",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.2.2"
  },
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
